# Copy this file to .env only when you want the LLM step.
# The graph steps work with the defaults in config.py and do not need this file.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ticket123

# Leave the key empty to skip the model and copy the best graph match.
# Any non-empty key turns the model on.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Local Ollama example (install Ollama, then pull a model):
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.2
